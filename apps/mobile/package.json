{
  "name": "@speedreader/mobile",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "build": "expo export --platform android --output-dir dist/android && expo export --platform ios --output-dir dist/ios",
    "dev": "expo start",
    "lint": "tsc --noEmit",
    "test": "bun test src",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@moritzbrantner/speed-reading": "workspace:*",
    "expo": "^53.0.0",
    "expo-constants": "~17.1.8",
    "expo-dev-client": "~5.2.4",
    "expo-document-picker": "~13.1.6",
    "expo-file-system": "~18.1.11",
    "expo-linking": "~7.1.7",
    "expo-router": "^5.0.0",
    "expo-status-bar": "~2.2.3",
    "react": "19.0.0",
    "react-native": "0.79.6",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.11.1"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-test-renderer": "^19.1.0",
    "bun-types": "^1.2.22",
    "react-test-renderer": "19.0.0",
    "typescript": "~5.8.3"
  },
  "expo": {
    "install": {
      "exclude": ["@types/react"]
    }
  }
}
