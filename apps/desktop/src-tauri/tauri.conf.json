{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Speedreader",
  "version": "0.0.1",
  "identifier": "dev.brantner.speedreader",
  "build": {
    "beforeDevCommand": "bun --cwd ../web dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "bun --cwd ../web build",
    "frontendDist": "../../web/out"
  },
  "app": {
    "windows": [
      {
        "title": "Speedreader",
        "width": 1100,
        "height": 760,
        "minWidth": 700,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
